{
  "manifest_version": 3,
  "name": "ASL Meeting Captions",
  "version": "1.1.0",
  "description": "Captions ASL signs in Google Meet using on-device hand tracking and a recognizer trained on your own signing.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "camera.html"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
