{
  "name": "fuzzy_goggles",
  "version": "1.0.0",
  "description": "Chrome extension that captions ASL signs in Google Meet using on-device hand tracking.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prebuild": "node scripts/ensure-model.mjs",
    "build": "vite build && vite build --mode camera",
    "watch": "node scripts/ensure-model.mjs && node scripts/watch.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KDaqrouq/fuzzy-goggles.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KDaqrouq/fuzzy-goggles/issues"
  },
  "homepage": "https://github.com/KDaqrouq/fuzzy-goggles#readme",
  "devDependencies": {
    "@types/chrome": "^0.1.38",
    "puppeteer-core": "^25.13.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34"
  }
}
